
(defwindow bar
  :wm-ignore true
  :monitor 0
  :windowtype "dock"
  :stacking "bg"
  :reserve (struts :distance "40px" :side "top")
  :geometry (geometry
    :x "15"
    :y "-20"
    :height "40px"
    :width "8%"
    :anchor "left bottom"
  )
  (bar)
)

(defwidget bar []
  (box
    :class "bar"
    :orientation "h"
    :vexpand false
    :hexpand false
    :space-evenly true
    (spacer)
  )
)

(defwidget spacer []
  (box :class "spacer" :orientation "h")
)
