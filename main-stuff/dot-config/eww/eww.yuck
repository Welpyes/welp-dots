(defwindow bar
  :wm-ignore true
  :monitor 0
  :windowtype "dock"
  :stacking "bg"
  :reserve (struts :distance "40px" :side "top")
  :geometry (geometry
    :x "15"
    :y "0"
    :height "88%"
    :width "50px"
    :anchor "left center"
  )
  (bar)
)

(defwidget bar []
  (box
    :class "bar"
    :orientation "v"
    :vexpand false
    :hexpand false
    :space-evenly true
    (top)
    (center)
    (bottom)
  )
)

(defwidget spacer []
  (box :class "spacer" :orientation "v")
)

(defwidget top[]
  (box
    :orientation "v"
    :valign "start"
    :space-evenly false
    :spacing 5
    (spacer)
  )
)

(defwidget center []
  (box
    :orientation "v"
    :valign "center"
    :space-evenly false
    :spacing 5
    (spacer)
  )
)

(defwidget bottom []
  (box
    :orientation "v"
    :valign "end"
    :space-evenly false
    :spacing 5
    (clock)
  )
)

(defwidget clock []
  (box
    :class "clock"
    (button
      :class "clock-button"
      :onclick "echo yes"
      (box
        :orientation "v"
        (label :text "${hour}")
        (label :text "${min}")
      )
    )
  )
)

(deflisten hour
  :initial "00"
  `bash -c 'while true; do date "+%I"; sleep $(( 60 - $(date "+%S") )); done'`
)
(deflisten min
  :initial "00"
  `bash -c 'while true; do date "+%M"; sleep $(( 60 - $(date "+%S") )); done'`
)
