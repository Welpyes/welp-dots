#!/data/data/com.termux/files/usr/bin/bash

xrdb-wrap() {
  local key="$1"
  xrdb -query | awk -v k="$key" '$1 == k":" {print $2}'
}

display(){
  bspc monitor -d 1 2 3 4 5
  xsetroot -cursor_name left_ptr
  xrdb -merge ~/.Xresources
  bspc config pointer_follows_focus false
  bspc config focus_follows_pointer true
}

gaps(){
  bspc config window_gap 10
  bspc config top_padding 40
  bspc config bottom_padding 10
  bspc config right_padding 110
  bspc config left_padding 110
}

clients(){
  bspc rule -a "Xfce4-taskmanager" state=floating layer=above
  bspc rule -a "firefox-default" desktop='^2'
  bspc rule -a "scratchpad" state=floating layer=above
}

border(){
  bspc config border_width 2
  bspc config normal_border_color "$(xrdb-wrap colors.black2)"
  bspc config active_border_color "$(xrdb-wrap colors.blue)"
  bspc config focused_border_color "$(xrdb-wrap colors.blue)"
}

fastcompmgr_config(){
  killall fastcompmgr > /dev/null 2>&1 & 
  sleep 1
  fastcompmgr \
    -Ccp \
    -l -15 \
    -t -15 \
    -o 0.5 \
    -w 2 \
    -b "$(xrdb-wrap colors.black2)" \
    -a "$(xrdb-wrap colors.blue)" \
    --blur 20 \
    -R 10
}

autostart(){
  pgrep -x sxhkd || sxhkd -c ~/.config/bspwm/sxhkdrc &
  feh --bg-fill ~/Pictures/gowall/kisaki-tokyo-night.png &
  eww open bar --toggle &
  dunst &
  # fastcompmgr_config &
  # picom &
}

__main__(){
  display
  gaps
  clients
  border
  autostart
}
__main__
